{
  "name": "@local/dsh-notes-wall",
  "version": "1.0.0",
  "private": true,
  "description": "A sticky-notes wall in the sidebar: capture an idea the moment it arrives.",
  "license": "MIT",
  "author": "evil3",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "notes",
    "sticky-notes",
    "sidebar",
    "productivity"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "icon-180.png",
    "screenshots.json",
    "screenshot-1.png",
    "screenshot-2.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
